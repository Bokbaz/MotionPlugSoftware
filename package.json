{
  "name": "motion-plug",
  "version": "0.3.1",
  "private": true,
  "description": "Motion Plug, an offline CEP motion graphics extension for Adobe Premiere Pro",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:assets": "npm run build && node scripts/render-previews.mjs && node scripts/generate-sfx.mjs && npm run build",
    "dev": "node scripts/dev-server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-build.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "verify": "npm run typecheck && npm test && npm run build:assets && npm run validate",
    "package:cep": "node scripts/package.mjs",
    "release": "bash build-release.sh",
    "version:set": "node scripts/set-version.mjs",
    "install:cep": "bash install/install-mac.sh",
    "test:browser": "node scripts/visual-smoke.mjs && node scripts/feature-smoke.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.10.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
